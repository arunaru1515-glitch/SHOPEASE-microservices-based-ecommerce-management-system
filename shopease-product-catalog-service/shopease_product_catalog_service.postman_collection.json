    {
      "name": "Inventory Management",
      "item": [
        {
          "name": "Get Current Stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "{{productId}}"]
            }
          }
        },
        {
          "name": "Stock IN - Increase Stock (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 15,\n  \"remarks\": \"Shipment received from supplier\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}/stock-in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "{{productId}}", "stock-in"]
            }
          }
        },
        {
          "name": "Stock OUT - Decrease Stock (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5,\n  \"remarks\": \"Customer order dispatched\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}/stock-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "{{productId}}", "stock-out"]
            }
          }
        },
        {
          "name": "Stock OUT - Attempt Reduce Below Zero (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 9999,\n  \"remarks\": \"Excessive deduction test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}/stock-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "{{productId}}", "stock-out"]
            }
          }
        },
        {
          "name": "View Stock History (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}/history?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "{{productId}}", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "List Low Stock Products (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
